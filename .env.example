# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# Backend veritabanı bağlantısı
DATABASE_URL=postgresql+asyncpg://usalp:change_me_strong_password@localhost:5432/usalp

# OpenRouter API (LLM erişimi)
LLM_API_KEY=sk-or-v1-...
