# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# Backend veritabanı bağlantısı
DATABASE_URL=postgresql+asyncpg://usalp:change_me_strong_password@localhost:5432/usalp

# OpenRouter API (LLM erişimi)
LLM_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api
LLM_MODEL=anthropic/claude-sonnet-4

# Production site / HTTPS
USALP_PUBLIC_URL=https://monitoring.example.com
USALP_SITE_ADDRESS=monitoring.example.com
ACME_EMAIL=admin@example.com
CORS_ORIGINS=https://monitoring.example.com
MAX_REQUEST_BODY_BYTES=1048576
MAX_REQUEST_BODY_SIZE=10MB

# JWT imzalama (openssl rand -hex 32 veya ./scripts/setup-prod.sh)
SECRET_KEY=change_me_32_byte_hex
DASHBOARD_USERNAME=admin
# Production'da zorunlu: bcrypt veya sha512-crypt hash.
# ./scripts/setup-prod.sh bunu otomatik üretir.
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_HASH=

# Sunucu durum ve veri saklama
SERVER_OFFLINE_AFTER_SECONDS=120
METRIC_RETENTION_DAYS=30
LOG_RETENTION_DAYS=14
SERVICE_STATUS_RETENTION_DAYS=7
AI_ANALYSIS_RETENTION_DAYS=90
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# Alert bildirimleri (boş bırakılan kanal devre dışı kalır)
ALERT_NOTIFICATIONS_ENABLED=true
ALERT_NOTIFICATION_TIMEOUT_SECONDS=5

# E-posta / SMTP
ALERT_EMAIL_HOST=
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_USE_SSL=false
ALERT_EMAIL_STARTTLS=true

# Telegram
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Slack incoming webhook
ALERT_SLACK_WEBHOOK_URL=

# Ortam
ENVIRONMENT=production

# Demo modu
DEMO_MODE=false
DEMO_SEED_RESET=true

# Dashboard (Next.js)
NEXT_PUBLIC_API_URL=/api/v1
