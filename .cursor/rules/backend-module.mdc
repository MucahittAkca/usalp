## Alarm Servisi (`services/alert_service.py`)

```python
THRESHOLDS = {
    "cpu_percent":  {"warning": 80.0, "critical": 90.0},
    "ram_percent":  {"warning": 85.0, "critical": 95.0},
    "disk_percent": {"warning": 85.0, "critical": 95.0},
}

async def check_thresholds(db: AsyncSession, server_id: int, payload: MetricPayload):
    """
    Her metrik için eşik kontrolü yapar.
    Yeni alert oluşturmadan önce aynı tipte aktif alert var mı kontrol eder.
    (Alert spam'ini önler)
    """
    # CPU kontrolü
    if payload.cpu.percent >= THRESHOLDS["cpu_percent"]["critical"]:
        await _create_alert_if_not_exists(
            db, server_id, type="cpu_threshold",
            severity="critical",
            message=f"CPU kullanımı kritik: %{payload.cpu.percent:.1f}"
        )
    
    # Servis failed kontrolü — her failed servis için alert
    for service in payload.services:
        if service.status == "failed":
            await _create_alert_if_not_exists(
                db, server_id, type="service_failed",
                severity="critical",
                message=f"Servis durumu: {service.name} failed"
            )
            # Failed servis → AI analizi tetikle
            await ai_service.trigger_analysis(db, server_id, alert_id=...)
    
    # Kritik log alert'i
    critical_logs = [l for l in payload.log_entries if l.level in ("CRITICAL", "ERROR")]
    if len(critical_logs) >= 5:  # 5+ kritik log → alert
        await _create_alert_if_not_exists(...)
```

