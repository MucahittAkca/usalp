## API Çağrısı (OpenRouter üzerinden)

```python
import anthropic
import json
from app.config import settings
from app.schemas.ai_analysis import AiAnalysisResult

async def call_claude(context_package: str) -> AiAnalysisResult:
    """
    OpenRouter üzerinden LLM API'yi çağırır ve structured output döner.
    JSON parse başarısız olursa retry yapar (max 2 kez).
    """
    client = anthropic.AsyncAnthropic(
        api_key=settings.LLM_API_KEY,
        base_url=settings.LLM_BASE_URL,
    )

    message = await client.messages.create(
        model=settings.LLM_MODEL,
        max_tokens=1024,
        system=SYSTEM_PROMPT,
        messages=[
            {
                "role": "user",
                "content": f"Aşağıdaki sistem verisini analiz et:\n\n{context_package}"
            }
        ],
    )

    raw_text = message.content[0].text

    # JSON parse — fence varsa temizle
    clean = raw_text.strip().removeprefix("```json").removesuffix("```").strip()

    try:
        parsed = json.loads(clean)
        return AiAnalysisResult(**parsed)
    except (json.JSONDecodeError, ValueError) as e:
        raise AiParseError(f"Claude yanıtı parse edilemedi: {e}") from e
```

