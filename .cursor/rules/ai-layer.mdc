## Manuel Analiz Endpoint'i (`routers/ai.py`)

```python
@router.post("/ai/analyze", response_model=ApiResponse[AiAnalysisSchema])
async def manual_analyze(
    request: ManualAnalyzeRequest,
    db: AsyncSession = Depends(get_db),
    current_user = Depends(get_current_user),  # Dashboard auth
):
    """
    Kullanıcının dashboard'dan manuel AI analizi tetiklemesi.
    Cooldown kontrolü yapılır.
    """
    if not await ai_service.can_trigger_analysis(db, request.server_id):
        raise HTTPException(
            status_code=429,
            detail="Bu sunucu için çok yakın zamanda analiz yapıldı. 5 dakika bekleyin."
        )
    
    result = await ai_service.trigger_analysis(db, request.server_id)
    if not result:
        raise HTTPException(status_code=503, detail="AI analizi şu anda kullanılamıyor")
    
    return {"data": result, "meta": {"timestamp": datetime.utcnow().isoformat()}}
```

