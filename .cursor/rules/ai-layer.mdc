## AI Servis Ana Fonksiyonu

```python
async def trigger_analysis(
    db: AsyncSession,
    server_id: int,
    alert_id: int | None = None,
) -> AiAnalysis | None:
    """
    Bir sunucu için AI analizi başlatır ve sonucu DB'ye kaydeder.
    Hata durumunda exception fırlatmaz — sadece loglar ve None döner.
    (AI hatası sistemin çalışmasını durdurmamalı)
    """
    try:
        # Bağlam verilerini çek
        logs = await log_repo.get_recent(db, server_id, limit=100)
        services = await service_repo.get_current(db, server_id)
        metrics = await metric_repo.get_latest(db, server_id)

        if not metrics:
            log.warning("ai_skip_no_metrics", server_id=server_id)
            return None

        # Bağlam paketi hazırla
        context = build_context_package(logs, services, metrics)

        # Claude çağrısı
        result = await call_claude(context)

        # DB'ye kaydet
        analysis = AiAnalysis(
            server_id=server_id,
            alert_id=alert_id,
            category=result.category,
            severity=result.severity,
            summary=result.summary,
            causes=result.likely_causes,
            commands=[c.model_dump() for c in result.suggested_commands],
            confidence=result.confidence,
        )
        db.add(analysis)
        await db.commit()

        log.info(
            "ai_analysis_complete",
            server_id=server_id,
            category=result.category,
            confidence=result.confidence,
        )
        return analysis

    except AiParseError as e:
        log.error("ai_parse_error", server_id=server_id, error=str(e))
        return None
    except anthropic.APIError as e:
        log.error("ai_api_error", server_id=server_id, status=e.status_code)
        return None
    except Exception as e:
        log.error("ai_unexpected_error", server_id=server_id, error=str(e))
        return None
```

