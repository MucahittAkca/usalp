## SWR Hook'ları (`hooks/`)

```typescript
// hooks/useServerMetrics.ts
import useSWR from "swr";
import { api } from "@/lib/api";

export function useServerMetrics(serverId: number) {
  const { data, error, isLoading } = useSWR(
    serverId ? `metrics-${serverId}` : null,
    () => api.servers.metrics(serverId),
    {
      refreshInterval: 30_000,      // 30 saniyede bir yenile
      revalidateOnFocus: true,
      dedupingInterval: 5_000,
    }
  );
  return { metrics: data?.data ?? [], error, isLoading };
}

// hooks/useAlerts.ts — Alarm sayısı badge için global state
export function useAlerts() {
  const { data, error, isLoading, mutate } = useSWR(
    "alerts",
    () => api.alerts.list(),
    { refreshInterval: 15_000 }     // Alert'ler daha sık yenilenir
  );
  return {
    alerts: data?.data ?? [],
    activeCount: data?.data.filter(a => !a.resolved_at).length ?? 0,
    error,
    isLoading,
    mutate,
  };
}
```

