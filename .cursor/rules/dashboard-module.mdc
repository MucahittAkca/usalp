// API'den gelen tüm tipler burada tanımlı
// Backend Pydantic şemalarıyla 1:1 eşleşmeli

export type Severity = "low" | "medium" | "high" | "critical";
export type ServerStatus = "online" | "offline" | "warning";
export type ServiceStatus = "active" | "inactive" | "failed" | "activating" | "deactivating";
export type AlertType = "cpu_threshold" | "ram_threshold" | "disk_threshold" | "service_failed" | "log_critical";
