  | "config_error" | "dependency_failure" | "resource_exhaustion";

export interface Server {
  id: number;
  name: string;
  hostname: string;
  ip_address: string;
  status: ServerStatus;
  created_at: string;
}

export interface Metric {
  id: number;
  server_id: number;
  cpu_percent: number;
  ram_percent: number;
  disk_percent: number;
  network_in_bytes: number;
  network_out_bytes: number;
  load_avg_1: number;
  load_avg_5: number;
  load_avg_15: number;
  recorded_at: string;
}

export interface Service {
  name: string;
  status: ServiceStatus;
  sub_state: string;
  since_seconds: number | null;
}

export interface LogEntry {
  id: number;
  source_file: string;
  level: string;
  message: string;
  raw_line: string;
  logged_at: string;
}

export interface Alert {
  id: number;
  server_id: number;
  type: AlertType;
  severity: Severity;
  message: string;
  resolved_at: string | null;
  created_at: string;
}

export interface AiAnalysis {
  id: number;
  alert_id: number | null;
  server_id: number;
  category: ErrorCategory;
  severity: Severity;
  summary: string;
  likely_causes: string[];
  suggested_commands: Array<{ command: string; description: string }>;
  confidence: number;
  created_at: string;
}

// API response wrapper
export interface ApiResponse<T> {
  data: T;
  meta: { timestamp: string };
}

export interface PaginatedResponse<T> {
  data: T[];
  meta: { total: number; page: number; per_page: number };
}
