## AI Analiz Paneli

```tsx
// components/ai/AnalysisPanel.tsx

// Confidence bar rengi
const confidenceColor = (c: number) =>
  c >= 0.8 ? "bg-green-500" : c >= 0.5 ? "bg-yellow-500" : "bg-red-500";

// Komut bloğu — kopyala butonu zorunlu
function CommandBlock({ command, description }: { command: string; description: string }) {
  const [copied, setCopied] = useState(false);
  return (
    <div className="font-mono bg-gray-900 text-green-400 rounded-md p-3 flex justify-between">
      <span>{command}</span>
      <button onClick={() => { navigator.clipboard.writeText(command); setCopied(true); }}>
        {copied ? <Check size={14} /> : <Copy size={14} />}
      </button>
    </div>
  );
}
```

**Önemli:** AI analiz panelinde komutlar sadece gösterilir, çalıştırma butonu **olmaz**.
"Bu komutları kopyalayıp terminalde çalıştırın" ibaresi her zaman gösterilir.

