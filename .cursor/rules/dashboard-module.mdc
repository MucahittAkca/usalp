## API Katmanı (`lib/api.ts`)

```typescript
const API_BASE = process.env.NEXT_PUBLIC_API_URL ?? "http://localhost:8000/api/v1";

async function apiFetch<T>(path: string, options?: RequestInit): Promise<T> {
  const token = getToken(); // lib/auth.ts
  const res = await fetch(`${API_BASE}${path}`, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...options?.headers,
    },
  });

  if (res.status === 401) {
    clearToken();
    window.location.href = "/login";
    throw new Error("Unauthorized");
  }

  if (!res.ok) {
    const error = await res.json().catch(() => ({}));
    throw new Error(error?.error?.message ?? `HTTP ${res.status}`);
  }

  return res.json();
}

// Tüm endpoint'ler burada
export const api = {
  servers: {
    list: () => apiFetch<PaginatedResponse<Server>>("/servers"),
    get: (id: number) => apiFetch<ApiResponse<Server>>(`/servers/${id}`),
    metrics: (id: number, from?: string, to?: string) =>
      apiFetch<PaginatedResponse<Metric>>(
        `/servers/${id}/metrics?${new URLSearchParams({ ...(from && { from_dt: from }), ...(to && { to_dt: to }) })}`
      ),
    services: (id: number) => apiFetch<ApiResponse<Service[]>>(`/servers/${id}/services`),
    logs: (id: number, level?: string) =>
      apiFetch<PaginatedResponse<LogEntry>>(`/servers/${id}/logs${level ? `?level=${level}` : ""}`),
  },
  alerts: {
    list: () => apiFetch<PaginatedResponse<Alert>>("/alerts"),
    resolve: (id: number) =>
      apiFetch<ApiResponse<Alert>>(`/alerts/${id}/resolve`, { method: "PATCH" }),
  },
  ai: {
    analyze: (serverId: number) =>
      apiFetch<ApiResponse<AiAnalysis>>("/ai/analyze", {
        method: "POST",
        body: JSON.stringify({ server_id: serverId }),
      }),
    analyses: (serverId: number) =>
      apiFetch<PaginatedResponse<AiAnalysis>>(`/ai/analyses/${serverId}`),
  },
};
```

